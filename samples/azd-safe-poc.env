# Reference-only, secret-free azd values. Review every value before deployment.
# Copy individual values with `azd env set`; do not treat this file as credentials.
AZURE_LOCATION="eastus"
GSA_ORGANIZATION_NAME="Review Before Deployment"

# Azure features are disabled unless explicitly reviewed.
GSA_ENABLE_DIAGNOSTICS="false"
GSA_LOG_ANALYTICS_WORKSPACE_ID=""
GSA_ENABLE_DEFENDER_FOR_KEY_VAULT="false"
GSA_ENABLE_PRIVATE_ENDPOINT="false"
GSA_PRIVATE_ENDPOINT_SUBNET_ID=""
GSA_PRIVATE_DNS_ZONE_ID=""
GSA_PRIVATE_ENDPOINT_LOCATION=""
GSA_ACKNOWLEDGE_PRIVATE_ENDPOINT_RUNNER_ACCESS="false"

# Microsoft Graph beta and tenant mutations are disabled.
GSA_ACCEPT_GRAPH_BETA_TERMS="false"
GSA_ENABLE_TENANT_ONBOARDING="false"
GSA_ALLOW_UNDOCUMENTED_TENANT_ONBOARDING="false"
GSA_M365_PROFILE_STATE="Unchanged"
GSA_PRIVATE_PROFILE_STATE="Unchanged"
GSA_INTERNET_PROFILE_STATE="Unchanged"
GSA_ENABLE_QUICK_ACCESS="false"
GSA_ENABLE_PRIVATE_ACCESS_APP="false"
GSA_ENABLE_TLS_INSPECTION="false"
GSA_ROTATE_TLS_CERTIFICATE="false"
GSA_ALLOW_UNDOCUMENTED_CERTIFICATE_ENABLE="false"
GSA_INTUNE_ASSIGNMENT_MODE="None"
GSA_ACKNOWLEDGE_LAB_MODE="false"
GSA_ENABLE_INTERNET_BASELINE="false"

# Optional evidence and reviewed-plan inputs are empty by default.
GSA_OBSERVABILITY_PLAN_PATH=""
GSA_CLIENT_READINESS_EVIDENCE_PATH=""
GSA_REMOTE_NETWORK_PLAN_PATH=""
GSA_PREDOWN_LIVE_GRAPH_READS="false"
